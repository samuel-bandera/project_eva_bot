# EvalBot backend - configuracion de desarrollo
# Copiar a .env: cp .env.example .env
# En produccion cambiar JWT_SECRET, DB_PASSWORD y las API keys

# Servidor
PORT=3000
NODE_ENV=development

# MySQL (docker mapea 3306 -> 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=sistema_evaluaciones
DB_USER=los_de_siempre
DB_PASSWORD=123456

# JWT - minimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-in-production-1234567890abcdef
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Groq - sacar de https://console.groq.com/keys
# Si queda vacio, Noky responde sin IA (fallback basico)
GROQ_API_KEY=

# Gemini - sacar de https://aistudio.google.com/apikey
# Fallback secundario si Groq falla. Opcional.
GOOGLE_GENERATIVE_AI_API_KEY=

# SMTP - para envio de emails (verificacion de cuenta, avisos)
# Si queda vacio, los codigos se muestran en consola (modo desarrollo)
# Ejemplos: Gmail = smtp.gmail.com, Outlook = smtp-mail.outlook.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=EvalBot
SMTP_FROM_EMAIL=noreply@evalbot.local
